{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bark",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "ACTIVITY",
      "id": "b48e0d48d9944817bab6b716abbcb7e3",
      "remote": false
    }
  ]
}
